#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
APPROVAL_FILE="$REPO_ROOT/.git/approval-push"

# Bloquear push directo a master/main (INQUEBRANTABLE)
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "$remote_ref" ]; then
    continue
  fi
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      echo "❌ PUSH BLOQUEADO: no se permite push directo a '$remote_ref'."
      echo "   Crea una rama feature/fix y abre un Pull Request."
      exit 1
      ;;
  esac
done

if [ ! -f "$APPROVAL_FILE" ]; then
  echo "❌ PUSH BLOQUEADO: falta visto bueno del mantenedor."
  echo "   Ejecuta: scripts/approve-push.sh (o .ps1 en Windows)"
  exit 1
fi

# El hash almacenado debe coincidir con el HEAD actual
CURRENT_HEAD=$(git rev-parse HEAD)
STORED_HEAD=$(cat "$APPROVAL_FILE")

if [ "$CURRENT_HEAD" != "$STORED_HEAD" ]; then
  echo "❌ PUSH BLOQUEADO: HEAD cambió desde la aprobación."
  echo "   Vuelve a aprobar: scripts/approve-push.sh"
  rm -f "$APPROVAL_FILE"
  exit 1
fi

# Consumir aprobación (un solo uso)
rm -f "$APPROVAL_FILE"
echo "✅ Pre-push OK: aprobación válida."
exit 0
